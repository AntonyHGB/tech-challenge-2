# Copie para .env e ajuste conforme necessário. O .env é ignorado pelo git.
# Carregado e validado via Pydantic Settings (src/recsys/config.py).

# Reprodutibilidade
RANDOM_SEED=42

# Caminhos de dados, modelos e relatórios
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
MODELS_DIR=models
REPORTS_DIR=reports
PARAMS_FILE=configs/params.yaml

# MLflow. O padrão local é um store SQLite, exigido pelo Model Registry.
# O docker compose sobrescreve com http://mlflow:5000.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=ecommerce-recsys
MLFLOW_ARTIFACT_LOCATION=./mlartifacts
MLFLOW_REGISTERED_MODEL_NAME=ecommerce-recsys-recommender
