# Copy to .env and adjust as needed. .env is git-ignored.
# Loaded and validated via Pydantic Settings (src/recsys/config.py).

# Reproducibility
RANDOM_SEED=42

# Data, model and report paths
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
MODELS_DIR=models
REPORTS_DIR=reports
PARAMS_FILE=configs/params.yaml

# MLflow. The local default is a SQLite store, which the Model Registry needs.
# docker compose overrides it with http://mlflow:5000.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=ecommerce-recsys
MLFLOW_ARTIFACT_LOCATION=./mlartifacts
MLFLOW_REGISTERED_MODEL_NAME=ecommerce-recsys-recommender
